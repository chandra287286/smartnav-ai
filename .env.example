# Backend Configuration
APP_NAME=SmartNav AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS recommended; SQLite supported for local quickstart/testing)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartnav
# Local SQLite alternative for zero-dependency dev:
# DATABASE_URL=sqlite:///./smartnav.db

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173

# External Geospatial Services (OpenStreetMap / OSRM / Overpass)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SmartNavAI/1.0 (contact@smartnav.local)
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Live Traffic Provider (TomTom Routing & Traffic APIs - backend only)
TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
TRAFFIC_CACHE_TTL_SECONDS=35
TRAFFIC_MONITOR_INTERVAL_SECONDS=45
REROUTE_COOLDOWN_SECONDS=120
MIN_TIME_SAVING_SECONDS=300
MIN_RELATIVE_IMPROVEMENT=0.10

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
